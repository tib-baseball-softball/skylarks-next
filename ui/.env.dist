##---------------------- Actual Application------------------------ ##

# only used for Vite dev server (production environment sends requests to self)
# ignored for production builds
POCKETBASE_URL="http://localhost:8090"

# affects client-side-logging, for possible values see enum #lib/dp/types/LogLevel.ts
LOG_LEVEL="Error"

# affects verbosity of logging, non-production environments show visual indicator
APPLICATION_CONTEXT="Development"

# tile server to use for leaflet maps
TILE_SERVER="tile.openstreetmap.de"

# VAPID public key for web push functionality
VAPID_PUBLIC_KEY=""

##---------------------- DEV ONLY------------------------ ##

# Admin email and password for PocketBase authentication - only used for codegen during development
POCKETBASE_EMAIL=""
POCKETBASE_PASSWORD=""

# Testing
TEST_USER_NAME=""
TEST_USER_PASSWORD=""

# only used during local development for automatic translation (Wuchale)
#GEMINI_API_KEY=""
