##---------------------- Actual Application------------------------ ##

### URLs / External APIs ###

# used for initial Pocketbase app settings if set. Has no effect after inital migrations have run.
POCKETBASE_URL="http://localhost:8090"

# URL to use to query for BSM data (automatic import of games and location data).
BSM_API_URL="https://bsm.baseball-softball.de"

# Deprecated - BSM host without scheme - check usage
BSM_API_HOST="bsm.baseball-softball.de"

# URL to use for communication with Skylarks CMS website (local dev environment or production)
PUBLIC_TYPO3_URL="https://skylarks-cms.ddev.site"

# determines several logging details
APPLICATION_CONTEXT="Development"

# a very long string that should be impossible to guess
APPLICATION_SECRET=""

### fallback for events ###
TIME_ZONE="Europe/Berlin"

### keys for WebPush notifications ###

# VAPID public key, must match key set during frontend build (obviously) 
VAPID_PUBLIC_KEY=""

# VAPID private key
VAPID_PRIVATE_KEY=""

# subscriber email according to web push protocol
VAPID_SUBSCRIBER="webpush@example.org"

# these can be generated in TYPO3 backend, for communication with CMS website ###
PLAYER_CHANGE_WEBHOOK_IDENTIFIER=""
PLAYER_CHANGE_WEBHOOK_SECRET=""
PLAYER_UPDATE_REACTION_IDENTIFIER=""
PLAYER_UPDATE_REACTION_SECRET=""

# URL to send Sentry-compatible error events to
SENTRY_DSN=""
